{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "rootDir": ".",
    "outDir": "./dist",
    "module": "ES2022",
    "target": "ES2022",
    "lib": ["esnext"],
    "types": ["node"],
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/database/*": ["./src/database/*"],
      "hyperin/validation": ["./node_modules/hyperin/dist/validation"],
      "hyperin/response": ["./node_modules/hyperin/dist/response"],
    },
  },
}
